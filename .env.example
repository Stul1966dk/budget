# Supabase-projektets URL (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase publishable key (nyt nøgleformat, sb_publishable_..., erstatter anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Supabase secret key (nyt nøgleformat, sb_secret_..., erstatter service_role)
# KUN server-side - må ALDRIG have NEXT_PUBLIC_-præfiks eller bruges i klient-kode
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Kommasepareret liste over de eneste e-mails der må logge ind
ALLOWED_EMAILS=person1@example.com,person2@example.com

# Anthropic API-nøgle til budgetrådgiveren på /prognose (console.anthropic.com)
# KUN server-side - må ALDRIG have NEXT_PUBLIC_-præfiks
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Valgfri: standardmodel for rådgiveren (default: claude-opus-5). Kan
# overstyres direkte i appen under Rådgiver → Sprogmodel.
ANTHROPIC_MODEL=claude-sonnet-5
